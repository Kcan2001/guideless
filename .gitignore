# dependencies
node_modules/
.pnp
.pnp.*

# build outputs
.next/
out/
dist/
build/
# The Trip Builder route lives at app/(marketing)/tours/[slug]/build — not a build output.
!apps/web/app/**/build/
.turbo/
.vercel/
.expo/
web-build/
coverage/
guideless_photos/

# env files — never commit secrets
.env
.env.*
!.env.example

# supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# Firebase config files (per environment; supplied by EAS file env vars in CI)
apps/mobile/google-services.json
apps/mobile/GoogleService-Info.plist

# native folders (generated by expo prebuild)
apps/mobile/ios/
apps/mobile/android/
apps/mobile/expo-env.d.ts
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.metro-health-check*

# browser automation artifacts (screenshots, snapshots)
.playwright-mcp/
/*.png

# os / editor
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Playwright
playwright-report/
test-results/
