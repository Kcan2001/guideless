{
  "name": "@guideless/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Pure utilities shared by web, mobile and edge functions: money (integer minor units), time zones, formatting.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money.ts",
    "./time": "./src/time.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo \"(no lint configured for utils)\""
  },
  "dependencies": {
    "@guideless/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
