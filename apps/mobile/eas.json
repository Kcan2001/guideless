{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://<staging-ref>.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "<staging anon key>",
        "EXPO_PUBLIC_SITE_URL": "https://staging.guidelesstravel.com",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "EXPO_PUBLIC_POSTHOG_KEY": ""
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://<staging-ref>.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "<staging anon key>",
        "EXPO_PUBLIC_SITE_URL": "https://staging.guidelesstravel.com",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "EXPO_PUBLIC_POSTHOG_KEY": ""
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://<prod-ref>.supabase.co",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "<prod anon key>",
        "EXPO_PUBLIC_SITE_URL": "https://guidelesstravel.com",
        "EXPO_PUBLIC_SENTRY_DSN": "",
        "EXPO_PUBLIC_POSTHOG_KEY": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
