# Copy to `.env.local` inside apps/web (Next.js) and `.env` inside apps/mobile (Expo).
# Never commit real values. See docs/deployment.md for the environment strategy.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefixed with NEXT_PUBLIC_ / EXPO_PUBLIC_. Never shipped to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Expo reads EXPO_PUBLIC_* — same values as the NEXT_PUBLIC_ ones above.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Guideless Tours <hello@guidelesstours.com>"

# ── Maps ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# ── Analytics / observability (docs/marketing.md) ──────────────────────────
# GA4 web data stream measurement id (G-XXXXXXX). Loaded with Consent Mode v2 defaults = denied.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Mobile: PostHog is the product analytics sink. GA4 for the app comes through Firebase
# Analytics (google-services.json / GoogleService-Info.plist in apps/mobile/, dev build required).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# ── Social publishing (Supabase Edge Function secrets — `supabase secrets set`, never NEXT_/EXPO_) ─
# Shared secret pg_cron sends in `x-cron-secret`; the same value goes into Vault as social_publish_secret.
SOCIAL_PUBLISH_SECRET=
# Instagram Graph API host. Default = "Instagram API with Instagram Login".
META_GRAPH_BASE=https://graph.instagram.com
# 1 = claim due posts and log, call no Meta endpoint (local / staging).
SOCIAL_DRY_RUN=1

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
