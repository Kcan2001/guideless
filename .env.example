# Copy to `.env.local` inside apps/web (Next.js) and `.env` inside apps/mobile (Expo).
# Never commit real values. See docs/deployment.md for the environment strategy.

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefixed with NEXT_PUBLIC_ / EXPO_PUBLIC_. Never shipped to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Expo reads EXPO_PUBLIC_* — same values as the NEXT_PUBLIC_ ones above.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Guideless Tours <hello@guidelesstours.com>"

# ── Maps ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# ── Analytics / observability ──────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
